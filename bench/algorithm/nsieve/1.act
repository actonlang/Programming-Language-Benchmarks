#!/usr/bin/env runacton

def nsieve(n: int):
    flags = bytearray(b"\x01" * n)
    if n > 0:
        flags[0] = 0
    if n > 1:
        flags[1] = 0
    i = 2
    while i * i < n:
        if flags[i] != 0:
            start = i * i
            # TODO: Retry a plain loop once bytearray stores avoid boxing.
            flags[start:n:i] = b"\x00" * ((n - 1 - start) // i + 1)
        i += 1
    count = flags.count(bytearray(b"\x01"))
    n_s = ""
    for j in range(0, (8-(len(str(n)))), 1):
        n_s += " "
    c_s = ""
    for j in range(0, (8-(len(str(count)))), 1):
        c_s += " "
    print("Primes up to %s%d %s%d" % (n_s, n, c_s, count))

actor main(env):
    n = 4 if len(env.argv) < 2 else int(env.argv[1])
    for i in range(0, 3, 1):
        nsieve(10000 << (n - i))
    env.exit(0)
